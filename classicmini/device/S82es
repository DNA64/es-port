es_dir=/var/lib/hakchi/es
case "$1" in
  start)
    [ -f "$es_dir/no_boot" ] && exit 0
    [ "$(cat "$es_dir/boot_default" 2>/dev/null)" = stock ] && exit 0
    for _ in $(seq 1 15); do
      "$es_dir/padstate" select && exit 0
      usleep 200000
    done
    start-stop-daemon -S -b -q -m -p /run/es-run.pid -x /bin/sh -- "$es_dir/es-run.sh"
  ;;
  stop)
    start-stop-daemon -K -q -p /run/es-run.pid
  ;;
esac
