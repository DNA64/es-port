es_dir=$installpath/emulationstation
media_mnt=/tmp/es_media
media_root=
media_mounted=

if mountpoint -q "$mountpoint/media" && [ -w "$mountpoint/media" ]; then
  media_root=$mountpoint/media
else
  mkdir -p "$media_mnt"
  for candidate in /dev/sda1 /dev/sda /dev/mmcblk0p1 /dev/mmcblk0; do
    [ -b "$candidate" ] || continue
    if mount -o rw,nosuid,nodev,noatime "$candidate" "$media_mnt" 2>/dev/null; then
      if [ -d "$media_mnt/$modname" ]; then
        media_root=$media_mnt
        media_mounted=1
        break
      fi
      umount "$media_mnt" 2>/dev/null
    fi
  done
fi
if [ -n "$media_root" ]; then
  theme_dst=$media_root/data/emulationstation/themes/simple
  theme_manifest=$theme_dst/.es-port.md5
  if [ -f "$theme_manifest" ]; then
    (cd "$theme_dst" && md5sum -c "$theme_manifest" 2>/dev/null | sed -n 's/: OK$//p') | while read -r file; do
      rm -f "${theme_dst:?}/${file:?}"
    done
    rm -f "$theme_manifest"
    find "$theme_dst" -depth -mindepth 1 -type d -exec rmdir {} + 2>/dev/null
    rmdir "$theme_dst" 2>/dev/null
  fi
  rmdir "$media_root/data/emulationstation/themes" 2>/dev/null
  audio_dst=$media_root/data/emulationstation/audio
  for audio_file in "$audio_dst"/*; do
    [ -f "$audio_file" ] || continue
    audio_sum=$(md5sum "$audio_file" | cut -d ' ' -f 1)
    if find "$mountpoint/usr/share" -name "${audio_file##*/}" -exec md5sum {} + 2>/dev/null | cut -d ' ' -f 1 | grep -q "^$audio_sum$"; then
      rm -f "${audio_file:?}"
    fi
  done
  rmdir "$audio_dst" 2>/dev/null
  es_media=$media_root/data/emulationstation
  if [ -d "$es_media" ] && [ -z "$(find "$es_media" -type f 2>/dev/null | head -n 1)" ]; then
    rm -rf "${es_media:?}"
  fi
  sync
  if [ -n "$media_mounted" ]; then
    umount "$media_mnt" 2>/dev/null
  fi
fi
rmdir "$media_mnt" 2>/dev/null

rm -f "$mountpoint/var/lib/clover/autotest" /run/es-run.pid
for item in "${es_dir:?}"/* "${es_dir:?}"/.[!.]*; do
  [ -e "$item" ] && [ "${item##*/}" != favorites.txt ] && rm -rf "${item:?}"
done
rmdir "$es_dir" 2>/dev/null
