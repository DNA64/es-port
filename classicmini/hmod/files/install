es_payload=$transferpath/usr/share/emulationstation
theme_tar=$es_payload/defaults/theme_simple.tar
es_dir=$installpath/emulationstation
media_mnt=/tmp/es_media
media_root=
media_mounted=

if mountpoint -q "$mountpoint/media" && [ -w "$mountpoint/media" ]; then
  media_root=$mountpoint/media
else
  mkdir -p "$media_mnt"
  for candidate in /dev/sda1 /dev/sda /dev/mmcblk0p1 /dev/mmcblk0; do
    [ -b "$candidate" ] || continue
    if mount -o rw,nosuid,nodev,noatime "$candidate" "$media_mnt" 2>/dev/null; then
      if [ -d "$media_mnt/$modname" ]; then
        media_root=$media_mnt
        media_mounted=1
        break
      fi
      umount "$media_mnt" 2>/dev/null
    fi
  done
fi
if [ -z "$media_root" ]; then
  rmdir "$media_mnt" 2>/dev/null
  echo "EmulationStation needs an SD card or USB stick for its theme. Insert one and install again; nothing was installed."
  return 1
fi

theme_dst=${media_root:?}/data/emulationstation/themes/simple
theme_manifest=$theme_dst/.es-port.md5
theme_src=/tmp/es_theme_simple
rm -rf "${theme_src:?}"
mkdir -p "$theme_src" "${theme_dst%/*}"
tar -xf "$theme_tar" -C "$theme_src"
if [ -d "$theme_dst" ]; then
  if [ -f "$theme_manifest" ]; then
    (cd "$theme_dst" && md5sum -c "$theme_manifest" 2>/dev/null | sed -n 's/: OK$//p') | while read -r file; do
      rm -f "${theme_dst:?}/${file:?}"
    done
    rm -f "$theme_manifest"
    find "$theme_dst" -depth -mindepth 1 -type d -exec rmdir {} + 2>/dev/null
  fi
  (cd "$theme_src" && find . -type f) | while read -r file; do
    [ -e "$theme_dst/$file" ] && continue
    mkdir -p "${theme_dst}/${file%/*}"
    cp "$theme_src/$file" "$theme_dst/$file"
  done
else
  cp -a "$theme_src" "$theme_dst"
fi
(cd "$theme_src" && find . -type f -exec md5sum {} +) > "$theme_manifest"
rm -rf "${theme_src:?}"
rm -f "${theme_tar:?}"
sync
if [ -n "$media_mounted" ]; then
  umount "$media_mnt" 2>/dev/null
  rmdir "$media_mnt" 2>/dev/null
fi

mkdir -p "$es_dir"
for item in "$es_payload"/*; do
  cp -a "$item" "$es_dir/" && rm -rf "${item:?}"
done
chmod 755 "$es_dir/emulationstation" "$es_dir/padstate" "$es_dir"/*.sh
rm -rf "${es_dir:?}/library" "${es_dir:?}/library.stamp" "${es_dir:?}/library.stamp.count"
rm -f "${es_dir:?}/boot_failures" "${es_dir:?}/no_boot"
[ "$(cat "$es_dir/boot_default" 2>/dev/null)" = stock ] && rm -f "${es_dir:?}/boot_default"
rm -rf "${es_payload:?}"
return 0
