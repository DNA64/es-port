es_dir=/var/lib/hakchi/es
es_payload=$rootfs/usr/share/emulationstation

mkdir -p "$es_dir/home/.emulationstation"
for item in "$es_payload"/*; do
  [ "${item##*/}" = defaults ] || { cp -a "$item" "$es_dir/" && rm -rf "$item"; }
done
for cfg in es_settings.cfg es_input.cfg; do
  [ -f "$es_dir/home/.emulationstation/$cfg" ] || cp "$es_payload/defaults/$cfg" "$es_dir/home/.emulationstation/"
done
chmod 755 "$es_dir/emulationstation" "$es_dir/padstate" "$es_dir"/*.sh
rm -f "$es_dir/boot_failures" "$es_dir/no_boot"
[ "$(cat "$es_dir/boot_default" 2>/dev/null)" = stock ] && rm -f "$es_dir/boot_default"
return 1
